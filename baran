             "https://github.com/CachyOS/proton-cachyos/releases/latest"],
            capture_output=True, text=True, check=False).stdout.strip()
        version = out.rsplit("/", 1)[-1]
    version = version.removeprefix("cachyos-")
    tag = f"cachyos-{version}"
    asset = f"proton-cachyos-{version}-{variant}"
    base = f"https://github.com/CachyOS/proton-cachyos/releases/download/{tag}"

    roots = steam_roots()
    dest = (roots[0] if roots else Path.home() / ".local/share/Steam") / "compatibilitytools.d"
    target = dest / asset
    if target.is_dir() and not args.force:
        ok(f"Already installed: {target}")
        return 0

    dest.mkdir(parents=True, exist_ok=True)
    import tempfile
    with tempfile.TemporaryDirectory() as tmp:
        tarball = Path(tmp) / f"{asset}.tar.xz"
        info(f"Downloading {asset}.tar.xz (about 350 MB)")
        if run_cmd(["curl", "-fL", "--retry", "3", "--progress-bar",
                    "-o", str(tarball), f"{base}/{asset}.tar.xz"]) != 0:
            return 1
        sums = Path(tmp) / "sha512"
        if run_cmd(["curl", "-fsSL", "-o", str(sums), f"{base}/{asset}.sha512sum"],
                   stderr=subprocess.DEVNULL) == 0:
            info("Verifying checksum")
            if run_cmd(["sha512sum", "-c", sums.name], cwd=tmp) != 0:
                die("Checksum mismatch")
        else:
            warn("No checksum published; skipping verification")
        if args.force and target.is_dir():
            shutil.rmtree(target, ignore_errors=True)
        info("Extracting")
        if run_cmd(["tar", "-xf", str(tarball), "-C", str(dest)]) != 0:
            return 1

    if not (target / "proton").is_file():
        die("Installation failed; proton script missing")
    ok(f"Installed: {target}")
    info("Restart Steam so it picks up the new compatibility tool")
    return 0


# --- GUI: GTK4 -------------------------------------------------------------


def run_gtk_gui() -> bool:
    try:
        import gi
        gi.require_version("Gtk", "4.0")
        from gi.repository import Gtk, Gio, GLib  # noqa: F401
    except Exception:
        return False

    class Window(Gtk.ApplicationWindow):
        def __init__(self, app):
            super().__init__(application=app, title=APP_NAME)
            self.set_default_size(780, 560)

            header = Gtk.HeaderBar()
            self.set_titlebar(header)
            for label, tip, handler in (
                ("Add game", "Pick a Windows .exe", self.on_add),
                ("Scan", "Search your disk for games", self.on_scan),
            ):
                btn = Gtk.Button(label=label)
                btn.set_tooltip_text(tip)
                btn.connect("clicked", handler)
                header.pack_start(btn)
            status_btn = Gtk.Button(label="Status")
            status_btn.connect("clicked", self.on_status)
            header.pack_end(status_btn)

            box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
            for side in ("top", "bottom", "start", "end"):
                getattr(box, f"set_margin_{side}")(8)

            self.listbox = Gtk.ListBox()
            self.listbox.set_selection_mode(Gtk.SelectionMode.SINGLE)
            self.listbox.connect("row-activated", self.on_row_activated)
            scrolled = Gtk.ScrolledWindow()
            scrolled.set_vexpand(True)
            scrolled.set_child(self.listbox)
            box.append(scrolled)

            toolbar = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6)
            for label, handler in (("Play", self.on_play),
                                   ("Runtime", self.on_runtime),
                                   ("Desktop entry", self.on_shortcut),
                                   ("Remove", self.on_remove)):
                btn = Gtk.Button(label=label)
                btn.connect("clicked", handler)
                toolbar.append(btn)
            self.status = Gtk.Label(xalign=1.0)
            self.status.set_hexpand(True)
            toolbar.append(self.status)
            box.append(toolbar)

            self.set_child(box)
            self.reload()

        def reload(self):
            child = self.listbox.get_first_child()
            while child is not None:
                nxt = child.get_next_sibling()
                self.listbox.remove(child)
                child = nxt
            settings = load_settings()
            for game in load_games():
                row = Gtk.ListBoxRow()
                vbox = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
                for side in ("top", "bottom", "start", "end"):
                    getattr(vbox, f"set_margin_{side}")(6)
                title = Gtk.Label(xalign=0)
                title.set_markup(f"<b>{GLib.markup_escape_text(game['name'])}</b>")
                runtime = resolve_runtime(game, settings)
                missing = "" if Path(game["exe"]).is_file() else "  (file missing)"
                sub = Gtk.Label(xalign=0)
                sub.set_markup(
                    f"<small>{GLib.markup_escape_text(runtime)} · "
                    f"{GLib.markup_escape_text(game['exe'])}{missing}</small>")
                vbox.append(title)
                vbox.append(sub)
                row.set_child(vbox)
                row.game_id = game["id"]
                self.listbox.append(row)
            self.status.set_text(f"{len(load_games())} game(s)")

        def selected(self):
            row = self.listbox.get_selected_row()
            if row is None:
                self.status.set_text("No game selected")
                return None
            return find_game(load_games(), row.game_id)

        def launch(self, game):
            self.status.set_text(f"Starting {game['name']} …")
            try:
                launch_game(game, load_settings(), detach=True, assume_yes=True)
                self.status.set_text(f"{game['name']} started")
            except SystemExit as exc:
                self.status.set_text(f"Error: {exc}")

        def on_row_activated(self, _lb, row):
            game = find_game(load_games(), row.game_id)
            if game:
                self.launch(game)

        def on_play(self, _b):
            game = self.selected()
            if game:
                self.launch(game)

        def on_runtime(self, _b):
            game = self.selected()
            if not game:
                return
            order = list(RUNTIMES)
            current = game.get("runtime", "auto")
            nxt = order[(order.index(current) + 1) % len(order)] if current in order else "auto"
            games = load_games()
            for g in games:
                if g["id"] == game["id"]:
                    g["runtime"] = nxt
            save_games(games)
            self.reload()
            self.status.set_text(f"{game['name']}: runtime = {nxt}")

        def on_shortcut(self, _b):
            game = self.selected()
            if game:
                self.status.set_text(f"Desktop entry: {write_shortcut(game).name}")

        def on_remove(self, _b):
            game = self.selected()
            if not game:
                return
            save_games([g for g in load_games() if g["id"] != game["id"]])
            remove_shortcut(game["id"])
            self.reload()
            self.status.set_text(f"{game['name']} removed")

        def on_add(self, _b):
            def handle(path: str):
                if path:
                    add_game(Path(path))
                    self.reload()

            try:
                dialog = Gtk.FileDialog()
                dialog.set_title("Select a game (.exe)")

                def done(dlg, res):
                    try:
                        file = dlg.open_finish(res)
                        handle(file.get_path() if file else "")
                    except Exception:
                        pass

                dialog.open(self, None, done)
            except AttributeError:
                chooser = Gtk.FileChooserNative(title="Select a game (.exe)",
                                                transient_for=self,
                                                action=Gtk.FileChooserAction.OPEN)

                def response(dlg, resp):
                    if resp == Gtk.ResponseType.ACCEPT:
                        handle(dlg.get_file().get_path())
                    dlg.destroy()

                chooser.connect("response", response)
                chooser.show()

        def on_scan(self, _b):
            self.status.set_text("Scanning …")
            found = scan_exes()
            if not found:
                self.status.set_text("Nothing new found")
                return
            win = Gtk.Window(title="Games found", transient_for=self, modal=True)
            win.set_default_size(700, 440)
            box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
            for side in ("top", "bottom", "start", "end"):
                getattr(box, f"set_margin_{side}")(8)
            listbox = Gtk.ListBox()
            listbox.set_selection_mode(Gtk.SelectionMode.NONE)
            checks = []
            for path in found:
                check = Gtk.CheckButton(label=f"{path.stem}  —  {path}")
                checks.append((check, path))
                listbox.append(check)
            scrolled = Gtk.ScrolledWindow()
            scrolled.set_vexpand(True)
            scrolled.set_child(listbox)
            box.append(scrolled)
            btn = Gtk.Button(label="Add selected")

            def confirm_add(_x):
                for check, path in checks:
                    if check.get_active():
                        add_game(path)
                self.reload()
                win.destroy()

            btn.connect("clicked", confirm_add)
            box.append(btn)
            win.set_child(box)
            win.present()

        def on_status(self, _b):
            rows, summary = doctor_report()
            text = "\n".join(f"{s.upper():<5} {t:<9} {d}" for s, t, d in rows)
            win = Gtk.Window(title="Status", transient_for=self, modal=True)
            win.set_default_size(660, 400)
            label = Gtk.Label(label=f"{text}\n\n{summary}")
            label.set_selectable(True)
            label.set_xalign(0)
            for side in ("top", "bottom", "start", "end"):
                getattr(label, f"set_margin_{side}")(12)
            scrolled = Gtk.ScrolledWindow()
            scrolled.set_child(label)
            win.set_child(scrolled)
            win.present()

    class App(Gtk.Application):
        def __init__(self):
            super().__init__(application_id="org.baran.Baran",
                             flags=Gio.ApplicationFlags.NON_UNIQUE)

        def do_activate(self):
            Window(self).present()

    App().run([])
    return True


# --- GUI: zenity fallback --------------------------------------------------


def run_zenity_gui() -> bool:
    zenity = which("zenity")
    if not zenity:
        return False
    while True:
        games = load_games()
        settings = load_settings()
        rows: list[str] = []
        for game in games:
            rows += [game["id"], game["name"], resolve_runtime(game, settings)]
        rows += ["+", "Add a game …", ""]
        rows += ["?", "Status", ""]

        proc = subprocess.run(
            [zenity, "--list", "--title", APP_NAME, "--width", "640", "--height", "460",
             "--text", "Pick a game to start:", "--column", "ID", "--column", "Game",
             "--column", "Runtime", "--hide-column", "1", "--print-column", "1", *rows],
            capture_output=True, text=True, check=False)
        if proc.returncode != 0:
            return True
        choice = proc.stdout.strip().split("|")[0]

        if choice == "+":
            pick = subprocess.run(
                [zenity, "--file-selection", "--title", "Select a game (.exe)",
                 "--file-filter", "Windows programs | *.exe *.EXE"],
                capture_output=True, text=True, check=False)
            if pick.returncode == 0 and pick.stdout.strip():
                add_game(Path(pick.stdout.strip()))
        elif choice == "?":
            rows_txt, summary = doctor_report()
            text = "\n".join(f"{s.upper():<5} {t:<9} {d}" for s, t, d in rows_txt)
            subprocess.run([zenity, "--info", "--title", "Status", "--width", "640",
                            "--text", f"{text}\n\n{summary}"], check=False)
        else:
            game = find_game(games, choice)
            if game:
                launch_game(game, settings, detach=True, assume_yes=True)


def cmd_gui(_args) -> int:
    ensure_dirs()
    write_app_shortcut()
    if os.environ.get("BARAN_GUI") != "zenity" and run_gtk_gui():
        return 0
    if run_zenity_gui():
        return 0
    warn("No GUI available (needs GTK4 or zenity); falling back to the list")
    return cmd_list(None)


# --- CLI -------------------------------------------------------------------


def cmd_add(args) -> int:
    env: dict[str, str] = {}
    for item in args.env or []:
        if "=" not in item:
            die(f"--env expects KEY=VALUE, got: {item}")
        key, value = item.split("=", 1)
        env[key] = value
    add_game(Path(args.exe), name=args.name or "", runtime=args.runtime,
             args=args.game_args or [], shortcut=not args.no_shortcut,
             prefix=args.prefix or "", proton=args.proton or "", env=env)
    return 0


def cmd_list(_args) -> int:
    games = load_games()
    if not games:
        info("No games yet. Add one with: baran add /path/to/game.exe")
        return 0
    settings = load_settings()
    width = max(len(g["name"]) for g in games)
    for game in games:
        mark = " " if Path(game["exe"]).is_file() else "!"
        print(f"{mark} {game['id']:<22} {game['name']:<{width}}  "
              f"{resolve_runtime(game, settings):<8} {game['exe']}")
    return 0


def cmd_run(args) -> int:
    games = load_games()
    game = find_game(games, args.game)
    if game is None:
        die(f"No such game: {args.game} (see 'baran list')")
    if args.runtime:
        game = dict(game, runtime=args.runtime)
    return launch_game(game, load_settings(), detach=args.detach,
                       print_only=args.print, assume_yes=args.yes,
                       keep_module=args.keep)


def cmd_remove(args) -> int:
    games = load_games()
    game = find_game(games, args.game)
    if game is None:
        die(f"No such game: {args.game}")
    save_games([g for g in games if g["id"] != game["id"]])
    remove_shortcut(game["id"])
    if args.purge:
        prefix = Path(game.get("prefix", ""))
        if prefix.is_dir() and PREFIX_DIR in prefix.parents:
            shutil.rmtree(prefix, ignore_errors=True)
            info(f"Removed prefix: {prefix}")
    ok(f"Removed: {game['name']}")
    return 0


def cmd_shortcut(args) -> int:
    games = load_games()
    targets = games
    if args.game:
        game = find_game(games, args.game)
        if game is None:
            die(f"No such game: {args.game}")
        targets = [game]
    write_app_shortcut()
    for game in targets:
        ok(f"{game['name']}: {write_shortcut(game)}")
    if not targets:
        info("No games yet; created the Baran entry only")
    return 0


def cmd_scan(args) -> int:
    found = scan_exes(extra_dirs=[Path(d).expanduser() for d in (args.dir or [])])
    if not found:
        info("Nothing new found")
        return 0
    for index, path in enumerate(found, 1):
        print(f"{index:>3}. {path}")
    if not args.add:
        info(f"{len(found)} candidate(s). Add them all with: baran scan --add")
        return 0
    for path in found:
        add_game(path)
    return 0


def cmd_prepare(args) -> int:
    ready, _ = prepare_cpuid(load_settings(), assume_yes=args.yes)
    return 0 if ready else 1


def cmd_unprepare(args) -> int:
    return 0 if unprepare_cpuid(force=args.force) else 1


def cmd_settings(args) -> int:
    settings = load_settings()
    if args.key is None:
        for key, value in sorted(settings.items()):
            print(f"{key:<20} {value}")
        print(f"\nFile: {SETTINGS_FILE}")
        return 0
    if args.key not in DEFAULT_SETTINGS:
        die(f"Unknown setting: {args.key} (see 'baran settings')")
    if args.value is None:
        print(settings.get(args.key, ""))
        return 0
    default = DEFAULT_SETTINGS[args.key]
    value: object = args.value
    if isinstance(default, bool):
        value = args.value.lower() in ("1", "true", "yes", "on")
    elif isinstance(default, int):
        try:
            value = int(args.value)
        except ValueError:
            die(f"{args.key} expects a number")
    settings[args.key] = value
    save_settings(settings)
    ok(f"{args.key} = {value}")
    return 0


def build_parser():
    import argparse

    parser = argparse.ArgumentParser(
        prog=APP,
        description=f"{APP_NAME} - run Windows games on Linux. Double-click and go.",
        epilog="Without a command the graphical interface opens.")
    parser.add_argument("--version", action="version", version=f"{APP_NAME} {VERSION}")
    sub = parser.add_subparsers(dest="command")

    p = sub.add_parser("gui", help="open the graphical interface")
    p.set_defaults(func=cmd_gui)

    p = sub.add_parser("add", help="add a game")
    p.add_argument("exe")
    p.add_argument("--name")
    p.add_argument("--runtime", choices=RUNTIMES, default="auto")
    p.add_argument("--prefix", help="reuse an existing Wine prefix or compatdata folder")
    p.add_argument("--proton", help="pin a Proton build for this game")
    p.add_argument("--env", action="append", metavar="KEY=VALUE",
                   help="extra environment variable, repeatable")
    p.add_argument("--no-shortcut", action="store_true")
    p.add_argument("game_args", nargs="*")
    p.set_defaults(func=cmd_add)

    p = sub.add_parser("list", help="list games")
    p.set_defaults(func=cmd_list)

    p = sub.add_parser("run", help="start a game")
    p.add_argument("game")
    p.add_argument("--runtime", choices=RUNTIMES)
    p.add_argument("--print", action="store_true", help="only show the command")
    p.add_argument("--detach", action="store_true", help="start in the background")
    p.add_argument("--keep", action="store_true", help="keep the CPUID module loaded")
    p.add_argument("--yes", "-y", action="store_true", help="skip confirmations")
    p.set_defaults(func=cmd_run)

    p = sub.add_parser("remove", help="remove a game")
    p.add_argument("game")
    p.add_argument("--purge", action="store_true", help="also delete its prefix")
    p.set_defaults(func=cmd_remove)

    p = sub.add_parser("shortcut", help="create desktop entries")
    p.add_argument("game", nargs="?")
    p.set_defaults(func=cmd_shortcut)

    p = sub.add_parser("scan", help="search the disk for games")
    p.add_argument("--add", action="store_true")
    p.add_argument("--dir", action="append")
    p.set_defaults(func=cmd_scan)

    p = sub.add_parser("doctor", help="check the environment")
    p.set_defaults(func=cmd_doctor)

    p = sub.add_parser("umip", help="how to disable UMIP")
    p.set_defaults(func=cmd_umip)

    p = sub.add_parser("prepare", help="load the CPUID module (unloads KVM)")
    p.add_argument("--yes", "-y", action="store_true")
    p.set_defaults(func=cmd_prepare)

    p = sub.add_parser("unprepare", help="unload the module, restore KVM")
    p.add_argument("--force", action="store_true")
    p.set_defaults(func=cmd_unprepare)

    p = sub.add_parser("install-deps", help="install build dependencies (Arch/CachyOS)")
    p.add_argument("--linuwux", action="store_true", help="only what LinUwUx needs")
    p.add_argument("--module", action="store_true", help="only what the kernel module needs")
    p.add_argument("--legion", action="store_true", help="also podman for building Legion")
    p.add_argument("--yes", "-y", action="store_true")
    p.set_defaults(func=cmd_install_deps)

    p = sub.add_parser("build-linuwux", help="build and install LinUwUx")
    p.add_argument("--ref", help="branch, tag, commit or prNN (default pr58)")
    p.add_argument("--src")
    p.set_defaults(func=cmd_build_linuwux)

    p = sub.add_parser("build-module", help="build the CPUID fault emulation module")
    p.add_argument("--dkms", action="store_true", help="install via DKMS plus systemd service")
    p.add_argument("--ref")
    p.add_argument("--src")
    p.add_argument("--jobs", type=int)
    p.set_defaults(func=cmd_build_module)

    p = sub.add_parser("build-legion", help="build Legion-KVM (long, needs podman)")
    p.add_argument("--src")
    p.add_argument("--jobs", type=int)
    p.add_argument("--yes", "-y", action="store_true")
    p.set_defaults(func=cmd_build_legion)

    p = sub.add_parser("install-proton", help="install Proton-CachyOS")
    p.add_argument("--version")
    p.add_argument("--variant", default="x86_64")
    p.add_argument("--force", action="store_true")
    p.set_defaults(func=cmd_install_proton)

    p = sub.add_parser("settings", help="show or change settings")
    p.add_argument("key", nargs="?")
    p.add_argument("value", nargs="?")
    p.set_defaults(func=cmd_settings)

    return parser


def main(argv: list[str] | None = None) -> int:
    args = build_parser().parse_args(sys.argv[1:] if argv is None else argv)
    ensure_dirs()
    if not getattr(args, "func", None):
        return cmd_gui(args)
    return args.func(args)


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except KeyboardInterrupt:
        print()
        raise SystemExit(130)
