def doctor_report(settings: dict | None = None) -> tuple[list[tuple[str, str, str]], str]:
    settings = settings or load_settings()
    rows: list[tuple[str, str, str]] = []

    rows.append(("ok", "System", f"{os.uname().sysname} {kernel_release()} ({os.uname().machine})"))

    protons = list_protons()
    umu = which("umu-run")
    if protons:
        best = pick_proton(settings.get("default_proton", ""))
        rows.append(("ok", "Proton", f"{len(protons)} found, preferred: {best.parent.name if best else '?'}"))
    elif umu:
        rows.append(("ok", "Proton", "none installed; umu-run will fetch one on first launch"))
    else:
        rows.append(("err", "Proton", "none found; install Proton (Steam/GE) or umu-run"))

    rows.append(("ok" if umu else "warn", "umu-run", umu or "not installed (optional)"))

    # Legion
    usable, detail = legion_usable(settings)
    rows.append(("ok" if usable else "warn", "Legion", detail if usable else f"unavailable: {detail}"))
    if kvm_available():
        rows.append(("ok", "KVM", "/dev/kvm usable"))
    elif Path("/dev/kvm").exists():
        rows.append(("warn", "KVM", "/dev/kvm exists but no permission (group 'kvm')"))
    else:
        rows.append(("warn", "KVM", "/dev/kvm missing"))

    # LinUwUx
    lib = find_linuwux(settings)
    rows.append(("ok" if lib else "warn", "LinUwUx",
                 str(lib) if lib else "not installed (baran build-linuwux)"))
    if umip_enabled():
        rows.append(("warn", "UMIP", "enabled; linuwux runtime needs it off (baran umip)"))
    else:
        rows.append(("ok", "UMIP", "disabled"))
    if cpuid_faulting_native():
        rows.append(("ok", "CPUID", "native faulting, no kernel module needed"))
    elif needs_cpuid_module():
        if module_loaded():
            rows.append(("ok", "CPUID", "emulation module loaded"))
        elif service_available():
            rows.append(("ok", "CPUID", "systemd service installed, module loads on demand"))
        else:
            ko = find_module_ko(settings)
            if ko and module_vermagic(ko) == kernel_release():
                rows.append(("ok", "CPUID", f"module built: {ko}"))
            elif ko:
                rows.append(("warn", "CPUID", f"module built for {module_vermagic(ko)}, kernel is {kernel_release()}"))
            else:
                rows.append(("warn", "CPUID", "no module (only needed for the linuwux runtime)"))
    else:
        rows.append(("warn", "CPUID", f"no native faulting and CPU is {cpu_vendor()}"))

    session = os.environ.get("XDG_SESSION_TYPE", "?")
    rows.append(("ok" if session == "wayland" else "warn", "Session",
                 f"{session} (Legion prefers Wayland)"))

    ram = host_ram_mib()
    mem = int(settings.get("legion_memory_mib") or 0) or max(4096, min(12288, int(ram * 0.6) // 512 * 512))
    rows.append(("ok" if ram >= 8192 else "warn", "Memory", f"{ram} MiB host, {mem} MiB planned for VM"))

    games = load_games()
    missing = [g for g in games if not Path(g["exe"]).is_file()]
    if games:
        detail = f"{len(games)} game(s)"
        if missing:
            detail += f", {len(missing)} with missing files"
        rows.append(("warn" if missing else "ok", "Games", detail))
    else:
        rows.append(("warn", "Games", "none yet; use 'baran add' or the GUI"))

    if needs_cpuid_module() and not module_loaded() and not service_available():
        if not (Path("/lib/modules") / kernel_release() / "build/Makefile").is_file():
            rows.append(("warn", "Headers",
                         f"kernel headers missing for {kernel_release()} "
                         f"(baran install-deps --module)"))

    for game in games:
        prefix = Path(game.get("prefix", ""))
        if not prefix.is_dir():
            continue
        recorded = proton_from_prefix(prefix)
        if recorded:
            chosen = pick_proton(game.get("proton") or settings.get("default_proton", ""),
                                 prefix=prefix)
            if chosen and chosen != recorded:
                rows.append(("warn", "Prefix",
                             f"{game['id']}: belongs to {recorded.parent.name}, "
                             f"would run {chosen.parent.name} (shader cache resets)"))
        if resolve_runtime(game, settings) == "linuwux":
            log = prefix / "pfx/winetricks.log"
            installed = log.is_file() and "vcrun2022" in log.read_text(
                encoding="utf-8", errors="replace")
            if (prefix / "pfx").is_dir() and not installed:
                rows.append(("warn", "Runtime libs",
                             f"{game['id']}: vcrun2022 not found in the prefix; "
                             f"if the game refuses to start: protontricks-launch or "
                             f"winetricks -q vcrun2022"))

    counts = {"ok": 0, "warn": 0, "err": 0}
    for state, _, _ in rows:
        counts[state] += 1
    summary = f"{counts['ok']} ok, {counts['warn']} notes, {counts['err']} errors"
    return rows, summary


def cmd_doctor(_args) -> int:
    rows, summary = doctor_report()
    symbols = {"ok": _c("32", "[ok]"), "warn": _c("33", "[!]"), "err": _c("31", "[x]")}
    for state, title, detail in rows:
        print(f"{symbols[state]} {title:<9} {detail}")
    print(f"\n{summary}")
    return 1 if any(s == "err" for s, _, _ in rows) else 0


def cmd_umip(_args) -> int:
    if not umip_enabled():
        ok("UMIP is already disabled")
        return 0
    err("UMIP is enabled; the linuwux runtime cannot work")
    try:
        cmdline = Path("/proc/cmdline").read_text(encoding="utf-8").strip()
        info(f"Current kernel cmdline: {cmdline}")
    except OSError:
        pass
    print("\nAdd clearcpuid=514 to your kernel command line, then reboot.\n")
    if which("rpm-ostree"):
        print("  sudo rpm-ostree kargs --append=clearcpuid=514")
    elif Path("/etc/default/grub").is_file():
        print("  sudoedit /etc/default/grub        # GRUB_CMDLINE_LINUX_DEFAULT=\"... clearcpuid=514\"")
        print("  sudo grub-mkconfig -o /boot/grub/grub.cfg")
    elif Path("/etc/kernel/cmdline").is_file():
        print("  sudoedit /etc/kernel/cmdline      # add clearcpuid=514")
        print("  sudo mkinitcpio -P")
    elif Path("/boot/limine.conf").is_file():
        print("  edit your Limine entry, then: sudo limine-update")
    else:
        print("  add clearcpuid=514 using your bootloader's usual method")
    print("\nThis taints the kernel; remove the parameter to undo it.")
    return 0


# --- Building the pieces ---------------------------------------------------


def _git_checkout(src: Path, repo: str, ref: str) -> bool:
    if not (src / ".git").is_dir():
        if src.exists() and any(src.iterdir()):
            err(f"{src} exists and is not a git clone")
            return False
        src.parent.mkdir(parents=True, exist_ok=True)
        if run_cmd(["git", "clone", repo, str(src)]) != 0:
            return False
    dirty = subprocess.run(["git", "-C", str(src), "status", "--porcelain"],
                           capture_output=True, text=True, check=False).stdout.strip()
    if dirty:
        err(f"Local changes in {src}; commit or discard them first")
        return False
    match = re.fullmatch(r"pr(\d+)", ref)
    if match:
        fetch = ["git", "-C", str(src), "fetch", "--depth=1", "origin",
                 f"pull/{match.group(1)}/head"]
    else:
        fetch = ["git", "-C", str(src), "fetch", "origin", ref]
    if run_cmd(fetch) != 0:
        return False
    return run_cmd(["git", "-C", str(src), "checkout", "--detach", "FETCH_HEAD"]) == 0


def cmd_build_linuwux(args) -> int:
    settings = load_settings()
    ref = args.ref or settings.get("linuwux_ref") or "pr58"
    src = Path(args.src).expanduser() if args.src else Path.home() / "linuwux-runtime"

    for tool in ("git", "cargo", "cc"):
        if not which(tool):
            die(f"{tool} is missing. On Arch: sudo pacman -S --needed git base-devel rust")

    info(f"Source: {src}")
    info(f"Ref:    {ref}")
    if not _git_checkout(src, LINUWUX_REPO, ref):
        return 1

    info("Building LinUwUx (this takes a few minutes)")
    if run_cmd(["cargo", "xtask", "build"], cwd=src) != 0:
        return 1

    built = src / "target/runtime/LinUwUx.so"
    if not built.is_file():
        die(f"Build produced no library at {built}")

    target = Path.home() / ".local/share/linuwux/LinUwUx.so"
    target.parent.mkdir(parents=True, exist_ok=True)
    shutil.copy2(built, target)
    target.chmod(0o644)
    settings["linuwux_lib"] = str(target)
    save_settings(settings)
    ok(f"Installed: {target}")
    return 0


def cmd_build_module(args) -> int:
    settings = load_settings()
    src = Path(args.src).expanduser() if args.src else Path.home() / "cpuid-fault-emulation"

    for tool in ("git", "make", "gcc"):
        if not which(tool):
            die(f"{tool} is missing. On Arch: sudo pacman -S --needed git base-devel")
    build_dir = Path("/lib/modules") / kernel_release() / "build"
    if not (build_dir / "Makefile").is_file():
        die(f"Kernel headers missing for {kernel_release()} "
            "(Arch: linux-headers, CachyOS: linux-cachyos-headers)")

    if not _git_checkout(src, MODULE_REPO, args.ref or "main"):
        return 1

    jobs = str(args.jobs or os.cpu_count() or 2)
    info(f"Building module for kernel {kernel_release()}")
    if run_cmd(["make", "-C", str(build_dir), f"M={src}", f"-j{jobs}", "modules"]) != 0:
        return 1

    ko = src / f"{MODULE_NAME}.ko"
    if not ko.is_file():
        die(f"Module not found: {ko}")
    vermagic = module_vermagic(ko)
    if vermagic != kernel_release():
        warn(f"vermagic {vermagic} differs from running kernel {kernel_release()}")
    settings["module_ko"] = str(ko)
    save_settings(settings)
    ok(f"Built: {ko}")

    if args.dkms:
        return _install_dkms(src)
    info("Load it on demand with: baran prepare")
    return 0


def _install_dkms(src: Path) -> int:
    if not which("dkms"):
        die("dkms is missing. On Arch: sudo pacman -S --needed dkms")
    sudo = sudo_prefix()
    version = "0.1"
    conf = src / "dkms.conf"
    if conf.is_file():
        match = re.search(r'PACKAGE_VERSION="([^"]+)"', conf.read_text(encoding="utf-8"))
        if match:
            version = match.group(1)

    dest = Path(f"/usr/src/{MODULE_NAME}-{version}")
    info(f"Installing sources to {dest}")
    run_cmd(sudo + ["rm", "-rf", str(dest)])
    run_cmd(sudo + ["mkdir", "-p", str(dest)])
    tar_out = subprocess.Popen(
        ["tar", "--exclude=.git", "--exclude=*.ko", "-C", str(src), "-cf", "-", "."],
        stdout=subprocess.PIPE)
    subprocess.run(sudo + ["tar", "-C", str(dest), "-xf", "-"], stdin=tar_out.stdout, check=False)
    tar_out.wait()

    run_cmd(sudo + ["dkms", "remove", "-m", MODULE_NAME, "-v", version, "--all"],
            stderr=subprocess.DEVNULL)
    for step in (["add"], ["build"], ["install", "--force"]):
        if run_cmd(sudo + ["dkms", *step, "-m", MODULE_NAME, "-v", version]) != 0:
            err(f"dkms {step[0]} failed")
            return 1
    run_cmd(sudo + ["depmod", "-a"])

    helper = src / "cpuid-fault-emulation-helper"
    service = src / SERVICE_NAME
    rules = src / "10-cpuid-fault-emulation.rules"
    if helper.is_file() and service.is_file():
        run_cmd(sudo + ["install", "-Dm755", str(helper),
                        f"/usr/lib/cpuid-fault-emulation/{helper.name}"])
        run_cmd(sudo + ["install", "-Dm644", str(service),
                        f"/etc/systemd/system/{SERVICE_NAME}"])
        if rules.is_file():
            run_cmd(sudo + ["install", "-Dm644", str(rules),
                            f"/etc/polkit-1/rules.d/{rules.name}"])
        run_cmd(sudo + ["systemctl", "daemon-reload"])
        ok("DKMS module and systemd service installed")
    else:
        ok("DKMS module installed")

    if which("mokutil"):
        out = subprocess.run(["mokutil", "--sb-state"], capture_output=True,
                             text=True, check=False).stdout.lower()
        if "enabled" in out:
            warn("Secure Boot is on; the module must be signed to load")
    return 0


def kernel_headers_package() -> str:
    """Best guess at the -headers package for the running kernel."""
    vmlinuz = Path("/usr/lib/modules") / kernel_release() / "vmlinuz"
    if which("pacman") and vmlinuz.exists():
        out = subprocess.run(["pacman", "-Qqo", str(vmlinuz)],
                             capture_output=True, text=True, check=False).stdout.strip()
        if out:
            return f"{out.splitlines()[-1]}-headers"
    rel = kernel_release()
    for flavour in ("cachyos", "zen", "lts", "hardened", "rt"):
        if flavour in rel:
            return f"linux-{flavour}-headers"
    return "linux-headers"


def cmd_install_deps(args) -> int:
    if not which("pacman"):
        err("This only knows pacman (Arch, CachyOS).")
        info("Install the equivalents of: git base-devel rust dkms kernel-headers")
        return 1

    pkgs = ["git", "base-devel"]
    want_all = not (args.linuwux or args.module or args.legion)
    if want_all or args.linuwux:
        pkgs.append("rust")
    if want_all or args.module:
        pkgs += ["dkms", kernel_headers_package()]
    if args.legion:
        pkgs.append("podman")

    info(f"Installing: {' '.join(pkgs)}")
    if not confirm("Continue?", default=True, assume_yes=args.yes):
        return 1
    cmd = sudo_prefix() + ["pacman", "-S", "--needed"]
    if args.yes:
        cmd.append("--noconfirm")
    if run_cmd(cmd + pkgs) != 0:
        err("pacman failed. If packages were not found, update first: sudo pacman -Syu")
        return 1

    if which("rustc"):
        version = subprocess.run(["rustc", "--version"], capture_output=True,
                                 text=True, check=False).stdout.split()
        if len(version) > 1:
            parts = [int(n) for n in re.findall(r"\d+", version[1])[:2]] or [0, 0]
            if (parts[0], parts[1]) < (1, 98):
                warn(f"Rust {version[1]} is older than 1.98; LinUwUx needs 1.98+")
                info("Install rustup: curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh")
    ok("Dependencies installed")
    return 0


