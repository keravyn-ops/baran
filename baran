#!/usr/bin/env python3
"""Baran - run Windows games on Linux. Double-click and go.

Baran keeps a list of your games, creates desktop entries for them and starts
them through one of three runtimes:

  proton   plain Proton/umu, the normal way
  legion   inside a KVM virtual machine (Legion), KVM stays available
  linuwux  with the LinUwUx preload and CPUID fault emulation, for titles
           whose anti-tamper code needs it

Proton, prefixes and runtimes are detected automatically; no setup required.
"""

from __future__ import annotations

import json
import os
import re
import shutil
import subprocess
import sys
import unicodedata
from datetime import datetime
from pathlib import Path

VERSION = "2.0.0"
APP = "baran"
APP_NAME = "Baran"
RUNTIMES = ("auto", "proton", "legion", "linuwux")

# --- Locations -------------------------------------------------------------


def _xdg(var: str, default: str) -> Path:
    return Path(os.environ.get(var) or Path.home() / default)


CONFIG_DIR = Path(os.environ.get("BARAN_CONFIG_DIR") or _xdg("XDG_CONFIG_HOME", ".config") / APP)
DATA_DIR = Path(os.environ.get("BARAN_DATA_DIR") or _xdg("XDG_DATA_HOME", ".local/share") / APP)
STATE_DIR = Path(os.environ.get("BARAN_STATE_DIR") or _xdg("XDG_STATE_HOME", ".local/state") / APP)

GAMES_FILE = CONFIG_DIR / "games.json"
SETTINGS_FILE = CONFIG_DIR / "settings.json"
PREFIX_DIR = DATA_DIR / "prefixes"
ICON_DIR = DATA_DIR / "icons"
LOG_DIR = STATE_DIR / "logs"
STATE_FILE = STATE_DIR / "cpuid.state"
APPLICATIONS_DIR = _xdg("XDG_DATA_HOME", ".local/share") / "applications"

SELF = Path(__file__).resolve()

MODULE_NAME = "cpuid_fault_emulation"
SERVICE_NAME = "cpuid-fault-emulation.service"
LINUWUX_REPO = "https://github.com/brcly/linuwux-runtime.git"
MODULE_REPO = "https://github.com/dnmodder/cpuid-fault-emulation.git"
LEGION_REPO = "https://github.com/brcly/legion-kvm.git"

DEFAULT_SETTINGS = {
    "default_runtime": "auto",   # auto | proton | legion | linuwux
    "default_proton": "",        # empty = detect
    "use_umu": True,             # prefer umu-run when available
    # legion
    "legion_path": "",
    "legion_memory_mib": 0,      # 0 = derive from host RAM
    "legion_fullscreen": False,
    # linuwux
    "linuwux_lib": "",           # empty = ~/.local/share/linuwux/LinUwUx.so
    "linuwux_ref": "pr58",       # branch, tag, commit or prNN
    "module_ko": "",             # empty = detect
    "use_service": True,         # prefer systemd service for the module
}

LINUWUX_DEFAULT_ENV = {
    "PROTON_AVX": "1",
    "LINUWUX_ARTIFACT_AMD_V2": "1",
}

# --- Output ----------------------------------------------------------------

_TTY = sys.stdout.isatty() and not os.environ.get("NO_COLOR")


def _c(code: str, text: str) -> str:
    return f"\033[{code}m{text}\033[0m" if _TTY else text


def info(msg: str) -> None:
    print(f"{_c('36', '[i]')} {msg}")


def ok(msg: str) -> None:
    print(f"{_c('32', '[ok]')} {msg}")


def warn(msg: str) -> None:
    print(f"{_c('33', '[!]')} {msg}")


def err(msg: str) -> None:
    print(f"{_c('31', '[x]')} {msg}", file=sys.stderr)


def die(msg: str, code: int = 1):
    err(msg)
    raise SystemExit(code)


def confirm(question: str, default: bool = False, assume_yes: bool = False) -> bool:
    if assume_yes:
        return True
    if not sys.stdin.isatty():
        warn(f"Not interactive, use --yes to confirm: {question}")
        return False
    suffix = "[Y/n]" if default else "[y/N]"
    try:
        answer = input(f"{question} {suffix} ").strip().lower()
    except EOFError:
        return False
    if not answer:
        return default
    return answer.startswith("y")


# --- Config ----------------------------------------------------------------


def ensure_dirs() -> None:
    for d in (CONFIG_DIR, DATA_DIR, STATE_DIR, PREFIX_DIR, ICON_DIR, LOG_DIR):
        d.mkdir(parents=True, exist_ok=True)


def load_json(path: Path, fallback):
    try:
        with path.open(encoding="utf-8") as fh:
            return json.load(fh)
    except FileNotFoundError:
        return fallback
    except (json.JSONDecodeError, OSError) as exc:
        warn(f"Cannot read {path} ({exc}); using defaults")
        return fallback


def save_json(path: Path, data) -> None:
    ensure_dirs()
    tmp = path.with_suffix(path.suffix + ".tmp")
    with tmp.open("w", encoding="utf-8") as fh:
        json.dump(data, fh, indent=2, ensure_ascii=False)
        fh.write("\n")
    tmp.replace(path)


def load_settings() -> dict:
    data = dict(DEFAULT_SETTINGS)
    data.update(load_json(SETTINGS_FILE, {}) or {})
    return data


def save_settings(settings: dict) -> None:
    save_json(SETTINGS_FILE, settings)


def load_games() -> list[dict]:
    games = load_json(GAMES_FILE, [])
    return games if isinstance(games, list) else []


def save_games(games: list[dict]) -> None:
    save_json(GAMES_FILE, games)


# --- Small helpers ---------------------------------------------------------


def which(name: str) -> str | None:
    return shutil.which(name)


def run_cmd(argv: list[str], **kwargs) -> int:
    return subprocess.run(argv, **kwargs).returncode


def slugify(text: str) -> str:
    text = unicodedata.normalize("NFKD", text).encode("ascii", "ignore").decode()
    text = re.sub(r"[^\w\s-]", "", text).strip().lower()
    text = re.sub(r"[\s_-]+", "-", text)
    return text or "game"


def unique_id(base: str, games: list[dict]) -> str:
    taken = {g.get("id") for g in games}
    if base not in taken:
        return base
    for n in range(2, 1000):
        candidate = f"{base}-{n}"
        if candidate not in taken:
            return candidate
    raise RuntimeError("no free id")


def host_ram_mib() -> int:
    try:
        with open("/proc/meminfo", encoding="utf-8") as fh:
            for line in fh:
                if line.startswith("MemTotal:"):
                    return int(line.split()[1]) // 1024
    except OSError:
        pass
    return 8192


def cpu_flags() -> set[str]:
    try:
        with open("/proc/cpuinfo", encoding="utf-8") as fh:
            for line in fh:
                if line.startswith("flags"):
                    return set(line.split(":", 1)[1].split())
    except OSError:
        pass
    return set()


def cpu_vendor() -> str:
    try:
        with open("/proc/cpuinfo", encoding="utf-8") as fh:
            for line in fh:
                if line.startswith("vendor_id"):
                    return line.split(":", 1)[1].strip()
    except OSError:
        pass
    return "unknown"


def kernel_release() -> str:
    return os.uname().release


def kvm_available() -> bool:
    return os.access("/dev/kvm", os.R_OK | os.W_OK)


def umip_enabled() -> bool:
    return "umip" in cpu_flags()


def cpuid_faulting_native() -> bool:
    return "cpuid_fault" in cpu_flags()


def loaded_modules() -> set[str]:
    try:
        with open("/proc/modules", encoding="utf-8") as fh:
            return {line.split()[0] for line in fh if line.strip()}
    except OSError:
        return set()


def module_loaded() -> bool:
    return MODULE_NAME in loaded_modules()


def kvm_loaded() -> bool:
    return bool({"kvm", "kvm_amd", "kvm_intel"} & loaded_modules())


def needs_cpuid_module() -> bool:
    """AMD before Zen 4 has no architectural CPUID faulting."""
    return not cpuid_faulting_native() and cpu_vendor() == "AuthenticAMD"


def service_available() -> bool:
    if not which("systemctl"):
        return False
    return subprocess.run(["systemctl", "cat", SERVICE_NAME],
                          stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL).returncode == 0


def module_vermagic(path: Path) -> str:
    if not which("modinfo") or not path.is_file():
        return ""
    out = subprocess.run(["modinfo", "-F", "vermagic", str(path)],
                         capture_output=True, text=True, check=False).stdout.strip()
    return out.split()[0] if out else ""


def sudo_prefix() -> list[str]:
    return [] if os.geteuid() == 0 else ["sudo"]


# --- Detection: Steam, Proton, runtimes ------------------------------------


def steam_roots() -> list[Path]:
    candidates = [
        Path.home() / ".local/share/Steam",
        Path.home() / ".steam/steam",
        Path.home() / ".steam/root",
        Path.home() / ".var/app/com.valvesoftware.Steam/.local/share/Steam",
    ]
    roots: list[Path] = []
    for c in candidates:
        if not c.is_dir():
            continue
        real = c.resolve()
        if real not in roots:
            roots.append(real)
    return roots


def steam_libraries() -> list[Path]:
    libs: list[Path] = []
    for root in steam_roots():
        if root not in libs:
            libs.append(root)
        vdf = root / "steamapps/libraryfolders.vdf"
        if not vdf.is_file():
            continue
        try:
            text = vdf.read_text(encoding="utf-8", errors="replace")
        except OSError:
            continue
        for match in re.finditer(r'"path"\s+"([^"]+)"', text):
            p = Path(match.group(1).replace("\\\\", "\\"))
            if p.is_dir() and p not in libs:
                libs.append(p)
    return libs


def list_protons() -> list[Path]:
    found: list[Path] = []
    bases: list[Path] = []
    for root in steam_roots():
        bases += [root / "compatibilitytools.d", root / "steamapps/common"]
    bases += [Path.home() / ".local/share/umu",
              Path.home() / ".local/share/lutris/runners/proton"]
    for base in bases:
        if not base.is_dir():
            continue
        try:
            entries = sorted(base.iterdir())
        except OSError:
            continue
        for entry in entries:
            script = entry / "proton"
            if script.is_file() and os.access(script, os.X_OK) and script not in found:
                found.append(script)
    return found


def proton_from_prefix(prefix: Path | str) -> Path | None:
    """Which Proton does this prefix belong to?

    Switching builds makes Proton upgrade the prefix and invalidates the shader
    cache, so always prefer the one already recorded inside it.
    """
    prefix = Path(prefix)
    if not prefix.is_dir():
        return None

    info_file = prefix / "config_info"
    if info_file.is_file():
        try:
            for line in info_file.read_text(encoding="utf-8", errors="replace").splitlines():
                if "/files/" in line:
                    candidate = Path(line.split("/files/")[0]) / "proton"
                    if candidate.is_file() and os.access(candidate, os.X_OK):
                        return candidate
                    break
        except OSError:
            pass

    version_file = prefix / "version"
    if version_file.is_file():
        try:
            name = version_file.read_text(encoding="utf-8", errors="replace").strip().splitlines()[0]
        except (OSError, IndexError):
            return None
        if name:
            for script in list_protons():
                if name in script.parent.name:
                    return script
    return None


def _proton_rank(path: Path) -> tuple:
    name = path.parent.name.lower()
    if "cachyos" in name:
        family = 0
    elif "ge-proton" in name or "proton-ge" in name:
        family = 1
    elif "umu" in name:
        family = 2
    elif "experimental" in name:
        family = 3
    else:
        family = 4
    nums = [int(n) for n in re.findall(r"\d+", path.parent.name)[:4]]
    nums += [0] * (4 - len(nums))
    return (family, [-n for n in nums])


def pick_proton(preferred: str = "", prefix: Path | str | None = None) -> Path | None:
    if preferred:
        p = Path(preferred).expanduser()
        if p.is_dir():
            p = p / "proton"
        if p.is_file():
            return p
        warn(f"Configured Proton not found: {preferred}")

    if prefix:
        from_prefix = proton_from_prefix(prefix)
        if from_prefix:
            return from_prefix

    protons = list_protons()
    if not protons:
        return None
    return sorted(protons, key=_proton_rank)[0]


def find_legion(settings: dict) -> Path | None:
    configured = settings.get("legion_path") or os.environ.get("BARAN_LEGION")
    if configured:
        p = Path(configured).expanduser()
        if p.is_file() and os.access(p, os.X_OK):
            return p
        warn(f"Configured Legion binary unusable: {configured}")
    candidates = [
        DATA_DIR / "legion",
        Path.home() / ".local/bin/legion",
        Path.home() / "legion-kvm/build/dist/legion",
    ]
    found = which("legion")
    if found:
        candidates.insert(0, Path(found))
    for c in candidates:
        if c.is_file() and os.access(c, os.X_OK):
            return c
    return None


def legion_usable(settings: dict) -> tuple[bool, str]:
    binary = find_legion(settings)
    if binary is None:
        return False, "legion binary not found"
    if not kvm_available():
        return False, "/dev/kvm not accessible"
    return True, str(binary)


def find_linuwux(settings: dict) -> Path | None:
    configured = settings.get("linuwux_lib")
    if configured:
        p = Path(configured).expanduser()
        if p.is_file():
            return p
        warn(f"Configured LinUwUx library not found: {configured}")
    default = Path.home() / ".local/share/linuwux/LinUwUx.so"
    return default if default.is_file() else None


def find_module_ko(settings: dict) -> Path | None:
    configured = settings.get("module_ko")
    if configured:
        p = Path(configured).expanduser()
        if p.is_file():
            return p
    local = Path.home() / "cpuid-fault-emulation" / f"{MODULE_NAME}.ko"
    if local.is_file():
        return local
    base = Path("/lib/modules") / kernel_release()
    if base.is_dir():
        for candidate in base.rglob(f"{MODULE_NAME}.ko*"):
            return candidate
    return None


def linuwux_usable(settings: dict) -> tuple[bool, str]:
    if find_linuwux(settings) is None:
        return False, "LinUwUx.so not found (baran build-linuwux)"
    if umip_enabled():
        return False, "UMIP is enabled (baran umip)"
    if not needs_cpuid_module():
        return True, "native CPUID faulting"
    if module_loaded():
        return True, "module loaded"
    if service_available():
        return True, "systemd service available"
    ko = find_module_ko(settings)
    if ko is None:
        return False, "CPUID module missing (baran build-module)"
    if module_vermagic(ko) != kernel_release():
        return False, "module built for another kernel (baran build-module)"
    return True, str(ko)


# --- CPUID module: load, unload, restore KVM -------------------------------


def state_write(method: str, kvm_was_loaded: bool) -> None:
    ensure_dirs()
    save_json(STATE_FILE, {
        "method": method,
        "kvm_was_loaded": kvm_was_loaded,
        "kernel": kernel_release(),
        "time": datetime.now().isoformat(timespec="seconds"),
    })


def state_read() -> dict:
    return load_json(STATE_FILE, {}) or {}


def state_clear() -> None:
    STATE_FILE.unlink(missing_ok=True)


def prepare_cpuid(settings: dict, assume_yes: bool = False) -> tuple[bool, bool]:
    """Make CPUID faulting available.

    Returns (ready, loaded_by_us). Unloads KVM when the module is needed.
    """
    if umip_enabled():
        err("UMIP is enabled; LinUwUx cannot work. Run 'baran umip' for instructions.")
        return False, False

    if not needs_cpuid_module():
        return True, False

    if module_loaded():
        if kvm_loaded():
            err("KVM and the CPUID module are both loaded; that conflicts.")
            return False, False
        return True, False

    if cpu_vendor() != "AuthenticAMD":
        err(f"The CPUID module only supports AMD CPUs (found {cpu_vendor()}).")
        return False, False

    warn("Loading an experimental kernel module; KVM will be unloaded while it is active.")
    if not confirm("Continue?", default=False, assume_yes=assume_yes):
        return False, False

    sudo = sudo_prefix()

    if settings.get("use_service", True) and service_available():
        info(f"Starting {SERVICE_NAME}")
        rc = run_cmd(["systemctl", "start", SERVICE_NAME],
                     stderr=subprocess.DEVNULL)
        if rc != 0:
            rc = run_cmd(sudo + ["systemctl", "start", SERVICE_NAME])
        if rc != 0 or not module_loaded():
            err("Could not start the service")
            return False, False
        state_write("service", False)
        ok("CPUID emulation active (systemd service)")
        return True, True

    ko = find_module_ko(settings)
    if ko is None:
        err("CPUID module not built. Run: baran build-module")
        return False, False
    vermagic = module_vermagic(ko)
    if vermagic and vermagic != kernel_release():
        err(f"Module was built for {vermagic}, running kernel is {kernel_release()}.")
        err("Rebuild with: baran build-module")
        return False, False

    kvm_was = kvm_loaded()
    if kvm_was:
        info("Unloading KVM")
        for mod in ("kvm_amd", "kvm_intel", "kvm"):
            if mod in loaded_modules():
                run_cmd(sudo + ["modprobe", "-r", mod], stderr=subprocess.DEVNULL)
        if kvm_loaded():
            err("KVM could not be unloaded. Stop running VMs and try again.")
            return False, False

    info(f"Loading {ko}")
    if run_cmd(sudo + ["insmod", str(ko)]) != 0 or not module_loaded():
        err("insmod failed")
        if kvm_was:
            run_cmd(sudo + ["modprobe", "kvm_amd"], stderr=subprocess.DEVNULL)
        return False, False

    state_write("manual", kvm_was)
    ok("CPUID emulation active")
    return True, True


def unprepare_cpuid(force: bool = False) -> bool:
    """Unload the module and bring KVM back."""
    state = state_read()
    sudo = sudo_prefix()

    if module_loaded():
        if not force and subprocess.run(["pgrep", "-f", r"\.exe"],
                                        stdout=subprocess.DEVNULL,
                                        stderr=subprocess.DEVNULL).returncode == 0:
            warn("A Windows process still seems to be running.")
        if state.get("method") == "service" or (not state and service_available()):
            info(f"Stopping {SERVICE_NAME}")
            rc = run_cmd(["systemctl", "stop", SERVICE_NAME], stderr=subprocess.DEVNULL)
            if rc != 0:
                rc = run_cmd(sudo + ["systemctl", "stop", SERVICE_NAME])
        else:
            info("Unloading CPUID module")
            run_cmd(sudo + ["modprobe", "-r", MODULE_NAME], stderr=subprocess.DEVNULL)
        if module_loaded():
            err("Module is still loaded")
            return False

    if state.get("kvm_was_loaded") and not kvm_loaded():
        info("Loading KVM again")
        mod = "kvm_amd" if cpu_vendor() == "AuthenticAMD" else "kvm_intel"
        run_cmd(sudo + ["modprobe", mod], stderr=subprocess.DEVNULL)

    state_clear()
    ok("Cleaned up" + (", KVM is back" if kvm_loaded() else ""))
    return True


# --- Game records ----------------------------------------------------------


def make_game(exe: Path, name: str = "", runtime: str = "auto",
              args: list[str] | None = None, games: list[dict] | None = None,
              prefix: str = "", proton: str = "") -> dict:
    games = games if games is not None else load_games()
    exe = exe.expanduser().resolve()
    display = name or exe.stem
    gid = unique_id(slugify(display), games)
    return {
        "id": gid,
        "name": display,
        "exe": str(exe),
        "args": args or [],
        "prefix": str(Path(prefix).expanduser()) if prefix else str(PREFIX_DIR / gid),
        "proton": str(Path(proton).expanduser()) if proton else "",
        "runtime": runtime,
        "env": {},
        "icon": "",
        "added": datetime.now().isoformat(timespec="seconds"),
        "last_played": "",
    }


def find_game(games: list[dict], needle: str) -> dict | None:
    for g in games:
        if g.get("id") == needle:
            return g
    lowered = needle.lower()
    matches = [g for g in games if lowered in g.get("name", "").lower()]
    return matches[0] if len(matches) == 1 else None


def resolve_runtime(game: dict, settings: dict) -> str:
    wanted = game.get("runtime") or settings.get("default_runtime") or "auto"
    if wanted != "auto":
        return wanted
    usable, _ = legion_usable(settings)
    return "legion" if usable else "proton"


# --- Building the launch command -------------------------------------------


def build_command(game: dict, settings: dict) -> tuple[list[str], dict[str, str], str]:
    exe = Path(game["exe"]).expanduser()
    if not exe.is_file():
        die(f"Game executable missing: {exe}")

    prefix = Path(game.get("prefix") or (PREFIX_DIR / game["id"])).expanduser()
    prefix.mkdir(parents=True, exist_ok=True)

    runtime = resolve_runtime(game, settings)
    env: dict[str, str] = {}

    proton_script = pick_proton(game.get("proton") or settings.get("default_proton", ""),
                                prefix=prefix)
    umu = which("umu-run") if settings.get("use_umu", True) else None
    use_umu = bool(umu) and not game.get("proton") and runtime != "linuwux"

    if use_umu:
        base = [umu, str(exe), *game.get("args", [])]
        env["GAMEID"] = game["id"]
        env["WINEPREFIX"] = str(prefix)
        if proton_script:
            env["PROTONPATH"] = str(proton_script.parent)
    else:
        if proton_script is None:
            die("No Proton found. Install Proton or umu-run, see 'baran doctor'.")
        client = steam_roots()[0] if steam_roots() else (DATA_DIR / "steam-compat")
        Path(client).mkdir(parents=True, exist_ok=True)
        base = [str(proton_script), "run", str(exe), *game.get("args", [])]
        env["STEAM_COMPAT_DATA_PATH"] = str(prefix)
        env["STEAM_COMPAT_CLIENT_INSTALL_PATH"] = str(client)

    if runtime == "legion":
        usable, detail = legion_usable(settings)
        if not usable:
            warn(f"Legion unusable ({detail}); falling back to Proton")
            runtime = "proton"
        else:
            mem = int(settings.get("legion_memory_mib") or 0)
            if mem <= 0:
                mem = max(4096, min(12288, int(host_ram_mib() * 0.6) // 512 * 512))
            env["LEGION_MEMORY_MIB"] = str(mem)
            if settings.get("legion_fullscreen"):
                env["LEGION_FULLSCREEN"] = "1"
            if use_umu or proton_script is None:
                argv = [detail, *base]
            else:
                argv = [detail, "run", "--proton", str(proton_script.parent),
                        "--prefix", str(prefix), "--", str(exe), *game.get("args", [])]
            env.update({k: str(v) for k, v in (game.get("env") or {}).items()})
            return argv, env, "legion"

    if runtime == "linuwux":
        lib = find_linuwux(settings)
        if lib is None:
            die("LinUwUx.so not found. Run: baran build-linuwux")
        preload = str(lib)
        existing = os.environ.get("LD_PRELOAD", "")
        if preload not in existing.split(":"):
            env["LD_PRELOAD"] = preload + (f":{existing}" if existing else "")
        for key, value in LINUWUX_DEFAULT_ENV.items():
            env.setdefault(key, value)

    env.update({k: str(v) for k, v in (game.get("env") or {}).items()})
    return base, env, runtime


def format_command(argv: list[str], env: dict[str, str]) -> str:
    import shlex
    parts = [f"{k}={shlex.quote(v)}" for k, v in sorted(env.items())]
    parts += [shlex.quote(a) for a in argv]
    return " ".join(parts)


# --- Launching -------------------------------------------------------------


def launch_game(game: dict, settings: dict, detach: bool = False,
                print_only: bool = False, assume_yes: bool = False,
                keep_module: bool = False) -> int:
    argv, extra_env, runtime = build_command(game, settings)

    if print_only:
        print(format_command(argv, extra_env))
        return 0

    loaded_by_us = False
    if runtime == "linuwux":
        ready, loaded_by_us = prepare_cpuid(settings, assume_yes=assume_yes)
        if not ready:
            return 1

    env = os.environ.copy()
    env.update(extra_env)
    workdir = Path(game["exe"]).parent

    ensure_dirs()
    stamp = datetime.now().strftime("%Y%m%d-%H%M%S")
    log_path = LOG_DIR / f"{game['id']}-{stamp}.log"
    latest = LOG_DIR / "latest.log"

    info(f"Starting {game['name']} via {runtime}")
    info(f"Log: {log_path}")

    games = load_games()
    for g in games:
        if g.get("id") == game.get("id"):
            g["last_played"] = datetime.now().isoformat(timespec="seconds")
    save_games(games)

    rc = 0
    try:
        with log_path.open("w", encoding="utf-8") as log:
            log.write(f"# {format_command(argv, extra_env)}\n")
            log.flush()
            try:
                latest.unlink(missing_ok=True)
                latest.symlink_to(log_path.name)
            except OSError:
                pass
            try:
                if detach:
                    subprocess.Popen(argv, cwd=workdir, env=env, stdout=log,
                                     stderr=subprocess.STDOUT, start_new_session=True)
                    ok(f"{game['name']} started")
                    if loaded_by_us and not keep_module:
                        warn("CPUID module stays loaded; run 'baran unprepare' when done.")
                    return 0
                rc = subprocess.run(argv, cwd=workdir, env=env).returncode
            except FileNotFoundError:
                err(f"Cannot execute: {argv[0]}")
                rc = 127
            except KeyboardInterrupt:
                rc = 130
    finally:
        if loaded_by_us and not detach:
            if keep_module:
                info("Keeping the CPUID module loaded (--keep)")
            else:
                unprepare_cpuid(force=True)
    return rc


