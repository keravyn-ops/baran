        path.unlink()
        refresh_desktop_db()


def refresh_desktop_db() -> None:
    tool = which("update-desktop-database")
    if tool:
        subprocess.run([tool, str(APPLICATIONS_DIR)],
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, check=False)


def extract_icon(exe: Path, game_id: str) -> str:
    wrestool, icotool = which("wrestool"), which("icotool")
    if not (wrestool and icotool):
        return ""
    ensure_dirs()
    tmp = ICON_DIR / f"{game_id}.ico"
    try:
        with tmp.open("wb") as fh:
            res = subprocess.run([wrestool, "-x", "-t", "14", str(exe)],
                                 stdout=fh, stderr=subprocess.DEVNULL, check=False)
        if res.returncode != 0 or tmp.stat().st_size == 0:
            tmp.unlink(missing_ok=True)
            return ""
        subprocess.run([icotool, "-x", "-o", str(ICON_DIR), str(tmp)],
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, check=False)
        tmp.unlink(missing_ok=True)
        pngs = sorted(ICON_DIR.glob(f"{game_id}*.png"),
                      key=lambda p: p.stat().st_size, reverse=True)
        if pngs:
            target = ICON_DIR / f"{game_id}.png"
            if pngs[0] != target:
                pngs[0].replace(target)
            for leftover in ICON_DIR.glob(f"{game_id}*.png"):
                if leftover != target:
                    leftover.unlink(missing_ok=True)
            return str(target)
    except OSError:
        tmp.unlink(missing_ok=True)
    return ""


# --- Adding and scanning ---------------------------------------------------

SKIP_EXE = re.compile(
    r"(unins|uninstall|setup|install|crashhandler|crashreport|vcredist|dxsetup|"
    r"directx|dotnet|launcher_helper|redist|benchmark|config\.exe|touchup|"
    r"webhelper|prereq|easyanticheat|battleye|oalinst|dotnetfx|ue4prereq)",
    re.IGNORECASE)

SCAN_DIRS = [
    Path.home() / "Games", Path.home() / "Spiele", Path.home() / "Downloads",
    Path.home() / "Desktop", Path.home() / "Schreibtisch",
]


def add_game(exe: Path, name: str = "", runtime: str = "auto",
             args: list[str] | None = None, shortcut: bool = True,
             prefix: str = "", proton: str = "", env: dict[str, str] | None = None) -> dict:
    exe = exe.expanduser().resolve()
    if not exe.is_file():
        die(f"File not found: {exe}")
    if exe.suffix.lower() != ".exe":
        warn(f"{exe.name} is not an .exe; adding anyway")

    games = load_games()
    for g in games:
        if Path(g["exe"]) == exe:
            warn(f"Already present: {g['name']} ({g['id']})")
            return g

    game = make_game(exe, name=name, runtime=runtime, args=args, games=games,
                     prefix=prefix, proton=proton)
    if env:
        game["env"] = env
    if prefix:
        recorded = proton_from_prefix(Path(prefix).expanduser())
        if recorded:
            info(f"Reusing existing prefix, built with {recorded.parent.name}")
    icon = extract_icon(exe, game["id"])
    if icon:
        game["icon"] = icon
    games.append(game)
    save_games(games)
    ok(f"Added: {game['name']} ({game['id']})")
    if shortcut:
        ok(f"Desktop entry: {write_shortcut(game)}")
    return game


def scan_exes(extra_dirs: list[Path] | None = None, limit: int = 400) -> list[Path]:
    roots = list(SCAN_DIRS)
    for lib in steam_libraries():
        common = lib / "steamapps/common"
        if common.is_dir():
            roots.append(common)
    roots += extra_dirs or []

    known = {Path(g["exe"]).resolve() for g in load_games()}
    results: list[Path] = []
    for root in roots:
        if not root.is_dir():
            continue
        for path in root.rglob("*.exe"):
            if len(results) >= limit:
                return results
            try:
                if path.stat().st_size < 1_000_000:
                    continue
            except OSError:
                continue
            if SKIP_EXE.search(path.name) or ".cache" in path.parts or "Trash" in path.parts:
                continue
            resolved = path.resolve()
            if resolved in known or resolved in results:
                continue
            results.append(resolved)
    return results


