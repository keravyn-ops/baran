def desktop_escape(value: str) -> str:
    return value.replace("\\", "\\\\").replace('"', '\\"').replace("%", "%%")


def game_icon(game: dict) -> str:
    icon = game.get("icon") or ""
    return icon if icon and Path(icon).is_file() else "applications-games"


def write_shortcut(game: dict) -> Path:
    APPLICATIONS_DIR.mkdir(parents=True, exist_ok=True)
    path = APPLICATIONS_DIR / f"baran-{game['id']}.desktop"
    exec_line = f'"{desktop_escape(str(SELF))}" run "{desktop_escape(game["id"])}"'
    path.write_text(
        "[Desktop Entry]\n"
        "Type=Application\n"
        f"Name={game['name']}\n"
        f"Comment=Start with {APP_NAME}\n"
        f"Exec={exec_line}\n"
        f"Icon={game_icon(game)}\n"
        "Terminal=false\n"
        "Categories=Game;\n"
        "StartupNotify=true\n"
        f"X-Baran-Id={game['id']}\n",
        encoding="utf-8")
    path.chmod(0o755)
    refresh_desktop_db()
    return path


